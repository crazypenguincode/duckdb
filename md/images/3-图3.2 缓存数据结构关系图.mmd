erDiagram
    CacheEntry {
        string query_sql
        bytes result_data
        timestamp last_accessed
    }
    
    BloomFilter {
        bitarray bit_vector
        array hash_functions
    }
    
    CTECacheEntry {
        string cte_name
        string definition_hash
    }
    
    IndexStructure {
        hashmap main_index
        btree time_index
    }
    
    CacheEntry ||--o{ IndexStructure : "indexed_by"
    CacheEntry ||--|| BloomFilter : "filtered_by"
    CTECacheEntry ||--o{ CacheEntry : "referenced_by"