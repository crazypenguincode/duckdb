flowchart TB
    subgraph "淘汰触发条件"
        T1[内存使用率 > 80%]
        T2[条目数量 > 阈值]
        T3[定时清理触发]
        T4[手动触发清理]
    end
    
    subgraph "策略评估阶段"
        E1[TTL过期检查]
        E2[LRU访问时间排序]
        E3[ML价值预测]
        E4[混合策略评分]
    end
    
    subgraph "决策融合阶段"
        F1[权重计算]
        F2[评分融合]
        F3[批量选择]
        F4[冲突解决]
    end
    
    subgraph "执行阶段"
        X1[锁定缓存区域]
        X2[批量删除条目]
        X3[更新索引结构]
        X4[释放内存空间]
        X5[更新统计信息]
    end
    
    T1 --> E1
    T2 --> E2
    T3 --> E3
    T4 --> E4
    
    E1 --> F1
    E2 --> F2
    E3 --> F3
    E4 --> F4
    
    F1 --> X1
    F2 --> X2
    F3 --> X3
    F4 --> X4
    
    X1 --> X2
    X2 --> X3
    X3 --> X4
    X4 --> X5
    
    style E1 fill:#ffebee
    style F2 fill:#e3f2fd
    style X2 fill:#e8f5e8