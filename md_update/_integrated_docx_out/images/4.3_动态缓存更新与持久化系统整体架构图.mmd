graph TB
    subgraph "应用接口层 Application Interface Layer"
        A1[SQL客户端<br/>SQL Client] --> A2[JDBC/ODBC接口<br/>JDBC/ODBC Interface]
        A3[REST API] --> A2
        A4[GraphQL接口<br/>GraphQL Interface] --> A2
    end
    
    subgraph "查询处理层 Query Processing Layer"
        B1[SQL解析器<br/>SQL Parser] --> B2[语法分析器<br/>Syntax Analyzer]
        B2 --> B3[语义分析器<br/>Semantic Analyzer]
        B3 --> B4[查询优化器<br/>Query Optimizer]
        B4 --> B5[执行计划生成器<br/>Plan Generator]
        B5 --> B6[执行引擎<br/>Execution Engine]
    end
    
    subgraph "智能缓存管理层 Intelligent Cache Management Layer"
        C1[缓存协调器<br/>Cache Coordinator] --> C2[策略选择器<br/>Strategy Selector]
        C2 --> C3[LRU管理器<br/>LRU Manager]
        C2 --> C4[TTL管理器<br/>TTL Manager]
        C2 --> C5[混合策略管理器<br/>Hybrid Strategy Manager]
        C2 --> C6[ML智能管理器<br/>ML-based Manager]
        C1 --> C7[性能监控器<br/>Performance Monitor]
        C7 --> C8[自适应调优器<br/>Adaptive Tuner]
    end
    
    subgraph "多模态持久化层 Multi-modal Persistence Layer"
        D1[持久化协调器<br/>Persistence Coordinator] --> D2[策略路由器<br/>Strategy Router]
        D2 --> D3[内存存储引擎<br/>Memory Storage Engine]
        D2 --> D4[WAL持久化引擎<br/>WAL Persistence Engine]
        D2 --> D5[物化视图引擎<br/>Materialized View Engine]
        D2 --> D6[混合持久化引擎<br/>Hybrid Persistence Engine]
        D1 --> D7[数据压缩器<br/>Data Compressor]
        D1 --> D8[完整性检查器<br/>Integrity Checker]
    end
    
    subgraph "增量更新与一致性层 Incremental Update & Consistency Layer"
        E1[变更监听器<br/>Change Listener] --> E2[依赖图构建器<br/>Dependency Graph Builder]
        E2 --> E3[影响分析器<br/>Impact Analyzer]
        E3 --> E4[增量更新器<br/>Incremental Updater]
        E4 --> E5[一致性维护器<br/>Consistency Maintainer]
        E5 --> E6[版本控制器<br/>Version Controller]
    end
    
    A2 --> B1
    B6 --> C1
    C1 --> D1
    E1 --> C1
    
    style C1 fill:#e1f5fe,stroke:#01579b,stroke-width:3px
    style C6 fill:#f3e5f5,stroke:#4a148c,stroke-width:3px
    style D1 fill:#e8f5e8,stroke:#1b5e20,stroke-width:3px
    style E4 fill:#fff3e0,stroke:#e65100,stroke-width:3px