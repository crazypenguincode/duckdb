graph TD
    A[WITH sales_data AS<br/>销售数据CTE] --> B[WITH customer_info AS<br/>客户信息CTE]
    B --> C[WITH regional_summary AS<br/>区域汇总CTE]
    C --> D[Main Query<br/>主查询]
    
    A --> A1[独立CTE<br/>可单独缓存<br/>Cache Level: High]
    B --> B1[依赖sales_data<br/>条件缓存<br/>Cache Level: Medium]
    C --> C1[依赖前两个CTE<br/>组合缓存<br/>Cache Level: Low]
    D --> D1[依赖所有CTE<br/>完整缓存<br/>Cache Level: Complete]
    
    style A1 fill:#e8f5e8
    style B1 fill:#fff3e0
    style C1 fill:#ffebee
    style D1 fill:#e3f2fd