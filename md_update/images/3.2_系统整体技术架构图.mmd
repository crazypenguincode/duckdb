graph TB
    subgraph "应用接口层 Application Interface Layer"
        A1[SQL客户端<br/>SQL Client]
        A2[查询接口<br/>Query Interface]
        A3[管理接口<br/>Management Interface]
    end
    
    subgraph "缓存管理层 Cache Management Layer"
        B1[查询拦截器<br/>Query Interceptor]
        B2[缓存管理器<br/>Cache Manager]
        B3[淘汰策略引擎<br/>Eviction Engine]
        B4[一致性控制器<br/>Consistency Controller]
    end
    
    subgraph "过滤检测层 Filtering Layer"
        C1[布隆过滤器<br/>Bloom Filter]
        C2[签名生成器<br/>Signature Generator]
        C3[查询标准化器<br/>Query Normalizer]
        C4[CTE分析器<br/>CTE Analyzer]
    end
    
    subgraph "存储管理层 Storage Management Layer"
        D1[内存缓存<br/>Memory Cache]
        D2[WAL持久化<br/>WAL Persistence]
        D3[物化视图存储<br/>Materialized View Storage]
        D4[混合存储<br/>Hybrid Storage]
    end
    
    subgraph "机器学习层 Machine Learning Layer"
        E1[特征提取器<br/>Feature Extractor]
        E2[预测模型<br/>Prediction Model]
        E3[在线学习器<br/>Online Learner]
        E4[性能监控器<br/>Performance Monitor]
    end
    
    subgraph "数据库引擎层 Database Engine Layer"
        F1[查询解析器<br/>Query Parser]
        F2[查询优化器<br/>Query Optimizer]
        F3[执行引擎<br/>Execution Engine]
        F4[存储引擎<br/>Storage Engine]
    end
    
    A1 --> A2
    A2 --> B1
    A3 --> B2
    
    B1 --> C3
    C3 --> C2
    C2 --> C1
    C1 --> B2
    B1 --> C4
    
    B2 --> D1
    B2 --> D2
    B2 --> D3
    B2 --> D4
    
    B2 --> E1
    E1 --> E2
    E2 --> B3
    E3 --> E2
    E4 --> E3
    
    B1 --> F1
    F1 --> F2
    F2 --> F3
    F3 --> F4
    F3 --> B2
    
    B2 --> B3
    B3 --> B4
    
